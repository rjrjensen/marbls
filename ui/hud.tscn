[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/celebration.gd" id="2_celebration"]
[ext_resource type="PackedScene" path="res://ui/celebration_card.tscn" id="3_card"]
[ext_resource type="Script" path="res://ui/cut_panel.gd" id="4_cut"]
[ext_resource type="PackedScene" path="res://ui/cards/card_face.tscn" id="5_face"]

[sub_resource type="StyleBoxFlat" id="BarStyle"]
bg_color = Color(0.1, 0.07, 0.04, 0.82)
content_margin_left = 18.0
content_margin_top = 14.0
content_margin_right = 18.0
content_margin_bottom = 14.0

[sub_resource type="StyleBoxEmpty" id="CardStyle"]

[sub_resource type="StyleBoxFlat" id="CardBackStyle"]
bg_color = Color(0.13, 0.27, 0.6, 1)
border_width_left = 8
border_width_top = 8
border_width_right = 8
border_width_bottom = 8
border_color = Color(0.95, 0.93, 0.86, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.1, 0.07, 0.04, 0.94)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
content_margin_left = 28.0
content_margin_top = 24.0
content_margin_right = 28.0
content_margin_bottom = 24.0

[sub_resource type="StyleBoxFlat" id="DrawNormal"]
bg_color = Color(0.13, 0.63, 0.3, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 6

[sub_resource type="StyleBoxFlat" id="DrawHover"]
bg_color = Color(0.18, 0.72, 0.36, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 6

[sub_resource type="StyleBoxFlat" id="DrawPressed"]
bg_color = Color(0.09, 0.5, 0.23, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

[sub_resource type="StyleBoxFlat" id="DrawDisabled"]
bg_color = Color(0.25, 0.25, 0.23, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

[node name="Hud" type="CanvasLayer"]
script = ExtResource("1_script")
card_back_style = SubResource("CardBackStyle")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("BarStyle")

[node name="Row" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2

[node name="Text" type="VBoxContainer" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TurnLabel" type="Label" parent="Root/TopBar/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Marbls"
clip_text = true
text_overrun_behavior = 3

[node name="MessageLabel" type="Label" parent="Root/TopBar/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.8, 1)
theme_override_font_sizes/font_size = 24
autowrap_mode = 3

[node name="MenuButton" type="Button" parent="Root/TopBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 70)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 24
text = "New game"

[node name="BottomBar" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("BarStyle")

[node name="Row" type="HBoxContainer" parent="Root/BottomBar"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 28

[node name="Card" type="PanelContainer" parent="Root/BottomBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 168)
layout_mode = 2
theme_override_styles/panel = SubResource("CardStyle")

[node name="CardFace" parent="Root/BottomBar/Row/Card" instance=ExtResource("5_face")]
unique_name_in_owner = true
layout_mode = 2

[node name="Actions" type="VBoxContainer" parent="Root/BottomBar/Row"]
layout_mode = 2
alignment = 1

[node name="DrawButton" type="Button" parent="Root/BottomBar/Row/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 120)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.9, 1, 0.9, 1)
theme_override_colors/font_disabled_color = Color(0.6, 0.6, 0.58, 1)
theme_override_font_sizes/font_size = 46
theme_override_styles/normal = SubResource("DrawNormal")
theme_override_styles/hover = SubResource("DrawHover")
theme_override_styles/pressed = SubResource("DrawPressed")
theme_override_styles/disabled = SubResource("DrawDisabled")
text = "Draw"

[node name="BackButton" type="Button" parent="Root/BottomBar/Row/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Back: pick another marble"

[node name="DeckLabel" type="Label" parent="Root/BottomBar/Row/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.8, 1)
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[node name="Celebration" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_celebration")
card_scene = ExtResource("3_card")

[node name="CutPanel" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_top = 0.2
anchor_right = 0.5
anchor_bottom = 0.2
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("PanelStyle")
script = ExtResource("4_cut")

[node name="Content" type="VBoxContainer" parent="Root/CutPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CutTitle" type="Label" parent="Root/CutPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Cutting for first player"
horizontal_alignment = 1

[node name="CutRows" type="VBoxContainer" parent="Root/CutPanel/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="NewGamePanel" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Content" type="VBoxContainer" parent="Root/NewGamePanel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Root/NewGamePanel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "New game: how many players?"
horizontal_alignment = 1

[node name="SeatButtons" type="GridContainer" parent="Root/NewGamePanel/Content"]
unique_name_in_owner = true
layout_mode = 2
columns = 3

[node name="ComputerToggle" type="CheckButton" parent="Root/NewGamePanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
button_pressed = true
text = "Play against the computer (you're Red)"

[node name="TeamsToggle" type="CheckButton" parent="Root/NewGamePanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Teams (partners sit opposite; 4, 6 or 8 players)"

[node name="CloseMenuButton" type="Button" parent="Root/NewGamePanel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Keep playing"

[node name="GameOverPanel" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Content" type="VBoxContainer" parent="Root/GameOverPanel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="WinnerLabel" type="Label" parent="Root/GameOverPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 44
horizontal_alignment = 1

[node name="PlayAgainButton" type="Button" parent="Root/GameOverPanel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Play again"
